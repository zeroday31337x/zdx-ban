{
  "schema_version": 1,
  "model": {
    "provider": "ollama",
    "name": "qwen2.5:1.5b",
    "foundation_id": "qwen2.5:1.5b",
    "base_url": "http://127.0.0.1:11434",
    "connect_timeout": "10s",
    "retries": 2,
    "max_response_bytes": 2097152
  },
  "generation": {
    "baseline": {"temperature": 0.2, "max_tokens": 1024},
    "proposal": {"temperature": 0.2, "max_tokens": 1024},
    "evaluation": {"temperature": 0.1, "max_tokens": 384},
    "challenge": {"temperature": 0.1, "max_tokens": 256},
    "final": {"temperature": 0.2, "max_tokens": 256}
  },
  "search": {
    "initial_branches": 5,
    "retain_branches": 2,
    "max_depth": 2,
    "max_nodes": 20,
    "max_concurrent_model_calls": 1,
    "max_concurrent_evaluations": 1,
    "max_active_branches": 3,
    "gravity_recovery_branches": 2
  },
  "runtime": {
    "run_timeout": "5m",
    "trace_dir": "traces",
    "benchmark_dataset": "datasets/initial.json",
    "memory_file": "memory/memory.jsonl"
  },
  "experiment": {
    "temperature": 0.2,
    "memory_temperature": 0.1,
    "max_tokens": 1024,
    "proposal_max_tokens": 1536,
    "evaluation_max_tokens": 384,
    "challenge_max_tokens": 256,
    "final_max_tokens": 256,
    "timeout": "15m",
    "inference_timeout": "15m",
    "case_timeout": "1h",
    "run_timeout": "5h",
    "repetitions": 1,
    "seed": 42
  }
}
