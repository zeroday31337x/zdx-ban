# Copy to training.env and replace every placeholder before enabling.
# The watchdog is deliberately inert until this is exactly 1.
ZDX_TRAINING_ENABLED=0
ZDX_TRAINING_STAGE=W1

ZDX_PROJECT_ROOT=/root/zdx-ban
ZDX_PYTHON=/path/to/venv/bin/python

# W0 stage: build a release with training/w0/prepare_release.py.
ZDX_W0_RELEASE=/path/to/immutable/W0-release

# W1 stage: point at the accepted W0 model-final and a reviewed W1 release.
ZDX_W1_RELEASE=/path/to/immutable/W1-release
ZDX_W0_TRANSFORMERS=/path/to/immutable/W0-transformers
ZDX_SLOW_OUTPUT=/path/to/isolated/training-output
ZDX_W1_CONFIG=/root/zdx-ban/training/slow_android/config.json
